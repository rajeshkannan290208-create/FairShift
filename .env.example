# FairShift Environment Configuration

# Application Mode: development | production
APP_ENV=development

# Server Binding
PORT=8080
HOST=0.0.0.0

# Database Connection
# Local Development (SQLite):
DATABASE_URL=sqlite:///./fairshift.db

# Cloud Run / Managed PostgreSQL (Cloud SQL):
# DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<CLOUD_SQL_IP_OR_PROXY>:5432/<DB_NAME>

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,*
